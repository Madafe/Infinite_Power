# Copia este archivo a .env y llena los valores - .env nunca se commitea
# (ver .gitignore). Sin .env, docker compose up falla porque estas dos
# variables ya no tienen default en docker-compose.yml (antes estaban en
# texto plano ahi mismo - corregido el 16 de agosto de 2026, Bloque 0 de
# la auditoria).

# Password de Postgres. Cualquier valor sirve en una instalacion nueva -
# lo unico que importa es que sea el mismo la primera vez que se levanta
# el contenedor (Postgres lo usa para inicializar el usuario infpower).
POSTGRES_PASSWORD=cambia_esto

# Clave de cifrado de n8n. n8n la usa para cifrar credenciales guardadas
# (tokens, API keys de nodos, etc.) dentro de su propia base. Si no se fija
# aqui, n8n genera una sola vez de forma automatica y la guarda en
# /home/node/.n8n/config dentro del volumen - eso funciona, pero significa
# que la clave real solo existe ahi, no en ningun lado versionado, y si se
# pierde el volumen se pierden todas las credenciales guardadas en n8n sin
# forma de recuperarlas. Poner un valor aqui ANTES del primer arranque deja
# la clave real tambien resguardada en este archivo (que el usuario debe
# respaldar el mismo, .env no se sube a git). Genera una con:
#   openssl rand -base64 24
N8N_ENCRYPTION_KEY=cambia_esto_tambien
